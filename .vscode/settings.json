{
  "files.associations": {
    "*.tsx": "typescriptreact",
    "*.jsx": "javascriptreact"
  },
  "tailwindCSS.includeLanguages": {
    "plaintext": "javascript",
    "typescript": "typescript",
    "typescriptreact": "javascriptreact"
  },
  "tailwindCSS.experimental.classRegex": [
    ["className\\s*=\\s*\"([^\"]*)\"", "\"([^\"]*)\""],
    ["className\\s*=\\s*'([^']*)'", "'([^']*)'"],
    ["className\\s*=\\s*`([^`]*)`", "`([^`]*)`"],
    ["class\\s*=\\s*\"([^\"]*)\"", "\"([^\"]*)\""],
    ["class\\s*=\\s*'([^']*)'", "'([^']*)'"],
    ["class\\s*=\\s*`([^`]*)`", "`([^`]*)`"],
    ["tw\\s*`([^`]*)`", "`([^`]*)`"]
  ],
  "editor.quickSuggestions": {
    "strings": true
  }
}
